{
  "name": "nlsbox",
  "version": "1.0.0",
  "description": "NLSbox Pro Engine - API for anime search and video streaming",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "session": "tsx generate-session.ts",
    "postinstall": "npm run build",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "big-integer": "^1.6.52",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.0",
    "express": "^4.21.2",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
